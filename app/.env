# Блокировка кнопки «Հաջորդ» (гейт D9).
#   true  — следующий раздел открывается только после действия: раскрыт
#           хотя бы один гайд, открыты все таблицы/пары/карточки (D16).
#   false — никаких блокировок: кнопка, боковая навигация и прямые URL
#           открыты всегда. Удобно для показа и отладки.
# Любое значение, кроме false, читается как true.
# Локально переопределить без правки этого файла: app/.env.local (не в git).
VITE_NEXT_STEP_BLOCKER=false
